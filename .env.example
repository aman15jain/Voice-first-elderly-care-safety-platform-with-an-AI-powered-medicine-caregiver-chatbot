# Used by docker-compose.yml. Copy to .env (never commit .env).
POSTGRES_USER=elderly_care
POSTGRES_PASSWORD=change_me
POSTGRES_DB=elderly_care

# Shared secret between the Node backend and the Python AI service
AI_SERVICE_API_KEY=change_me_internal_key

# Agentic AI service (passed to the agentic-ai container by docker-compose). Real values go only
# in your local, gitignored .env. Same Gemini key can be used for both LLM_API_KEY and EMBEDDING_API_KEY.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
# Same Supabase database as the backend's DIRECT_URL (unpooled), with the postgresql+psycopg:// scheme.
VECTOR_DB_URL=
# Leave as-is for compose (Node is `backend` on the compose network); do not use localhost here.
NODE_API_BASE_URL=http://backend:4000
NODE_API_TIMEOUT_SECONDS=5

CORS_ORIGINS=http://localhost:3000

# Auth secrets (generate real random strings for anything beyond local dev, e.g.
# `openssl rand -hex 32`). JWT_REFRESH_SECRET also peppers hashed refresh tokens.
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Reminder engine
DOSE_GENERATION_DAYS_AHEAD=2
MISSED_DOSE_GRACE_MINUTES=60
REMINDER_SWEEP_INTERVAL_MINUTES=15

# Per-service settings live in backend/.env.example and agentic-ai/.env.example
