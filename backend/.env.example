# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://elderly_care:change_me@localhost:5432/elderly_care?schema=public
# Used only by `prisma migrate`/`prisma validate`, never by the running app. Only needs to
# differ from DATABASE_URL if DATABASE_URL points at a connection pooler (e.g. Supabase's
# pgbouncer transaction-mode pooler, which can't run migrations) — set this to the same
# pooler's *direct/session-mode* URL in that case. Otherwise just set it equal to DATABASE_URL.
DIRECT_URL=postgresql://elderly_care:change_me@localhost:5432/elderly_care?schema=public

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
# Also used as the pepper mixed into hashed refresh tokens.
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Python AI service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=20000
# Shared secret Node sends to the AI service (internal calls only)
AI_SERVICE_API_KEY=change_me_internal_key

# --- Reminder engine ---
DOSE_GENERATION_DAYS_AHEAD=2
MISSED_DOSE_GRACE_MINUTES=60
REMINDER_SWEEP_INTERVAL_MINUTES=15
