APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Shared secret the Node backend sends in the x-internal-api-key header.
# Leave empty only for local development.
INTERNAL_API_KEY=change_me_internal_key

# --- Used from Phase 8/9 ---
# LLM_PROVIDER / EMBEDDING_PROVIDER: gemini (free key: aistudio.google.com/apikey) or mock (offline, deterministic).
# With gemini, the matching *_API_KEY is required; startup fails clearly if it is empty.
# Never commit a real key — put it only in the gitignored .env.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
# Supabase Postgres for the RAG vectors: the SAME database as the Node backend (use its DIRECT_URL,
# the unpooled/session-mode string, with the `postgresql+psycopg://` scheme). Needs the pgvector extension
# (created automatically). EMBEDDING_PROVIDER must be gemini — there is no local embedding fallback.
VECTOR_DB_URL=

# Connect to the vector DB and sync the knowledge base in the background at startup (never blocks it).
WARM_UP_ON_STARTUP=true
WARM_UP_TIMEOUT_SECONDS=90

# --- Phase 8: agents call back into Node for grounded, already-authorized elder data ---
NODE_API_BASE_URL=http://localhost:4000
NODE_API_TIMEOUT_SECONDS=5
